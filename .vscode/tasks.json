{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ElevenLabs: Hilfe",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "run_toolkit.py",
        "--help"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ElevenLabs: Transkription – Vorschau",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "run_toolkit.py",
        "--json",
        "transcribe",
        "--dry-run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ElevenLabs: Tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "ElevenLabs: Ruff prüfen",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "ruff",
        "check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ElevenLabs: Format prüfen",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "ruff",
        "format",
        "--check",
        "."
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "ElevenLabs: Typen prüfen",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "mypy",
        "src"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
